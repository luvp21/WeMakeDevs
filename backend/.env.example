# Local dev server config (backend/src/local-server.ts). Copy to .env.
PORT=4000

# AWS credentials for the AWS SDK (S3, ECS, Polly) — normally picked up from
# ~/.aws/credentials via `aws configure` instead of env vars. Set these only
# if not using a configured profile.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# S3 bucket for ingest results and locked scripts. Must already exist for
# local dev (SAM creates it automatically on deploy — see template.yaml).
S3_BUCKET=

# Which LLM provider script-gen uses (src/lib/llm/index.ts). Defaults to
# "gemini" if unset. "bedrock" is an optional alternative (needs Bedrock access).
LLM_PROVIDER=gemini

# Bedrock model ID, used only when LLM_PROVIDER=bedrock. Confirm against the Bedrock console for the account/region
# actually in use before relying on this default (see src/lib/llm/bedrock.ts).
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Gemini API key + model (primary provider). Get a key from
# Google AI Studio. GEMINI_MODEL defaults to "gemini-flash-latest" if unset
# (see src/lib/llm/gemini.ts).
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional — raises the GitHub API's unauthenticated rate limit (60 req/hr)
# for repo ingest. A public-repo read-only token is enough.
GITHUB_TOKEN=

# Which STT provider the sync pipeline uses (src/lib/transcribe/index.ts).
# Defaults to "groq" (Whisper large-v3 via the Groq API) if unset — proved
# out much better than AWS Transcribe on real code-switched Hindi/English
# speech, see PROGRESS.md. "aws" is the original AWS Transcribe path, kept
# as a fallback/comparison.
STT_PROVIDER=groq

# Required when STT_PROVIDER=groq. Get a key from console.groq.com.
GROQ_API_KEY=

# In the deployed stack the render is a Step Functions workflow (RENDER_STATE_MACHINE_ARN,
# set by the stack). Locally, use RENDER_MODE=local below instead.

# DynamoDB table with testers' usage counters (created by the stack, named <stack>-usage).
USAGE_TABLE=vaani-backend-usage

# Dev only: run the render worker from this checkout instead of launching a
# Fargate task. The Fargate image only changes when it is rebuilt and pushed, so
# a render there can run older code than the app being tested. Needs ffmpeg and
# Playwright's Chromium locally. Never set this in the deployed stack.
# RENDER_MODE=local

# Sign-in (src/lib/auth). Generated by `node backend/scripts/make-accounts.mjs`:
# AUTH_SECRET signs session tokens; AUTH_ACCOUNTS is the base64 of a JSON list of
# the fixed accounts with salted password hashes. Plain passwords are written to
# backend/.accounts.txt (git-ignored). Never commit either value.
AUTH_SECRET=
AUTH_ACCOUNTS=
